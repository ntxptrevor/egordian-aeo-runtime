    {"id": "custom_cabinetry", "candidate_default_id": "custom_cabinetry", "when": ["cabinet", "millwork"], "prompt": "Candidate default review: custom cabinetry scope and installation conditions.", "blocking": false},
    {"id": "equipment_mobilization", "candidate_default_id": "mobilization_system", "when": ["equipment", "rental", "lift", "trencher", "skid steer", "backhoe"], "prompt": "Candidate default review: mobilization for every equipment piece.", "blocking": false}
