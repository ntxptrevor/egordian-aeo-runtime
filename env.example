# eGordian AEO MCP service - environment variable NAMES ONLY.
# Never commit real values. Secrets are read from the environment or the
# platform vault at runtime and are never written to the database, the logs,
# an MCP result, or the operator console.

# ---- deployment ------------------------------------------------------------
DEPLOYMENT_ENV=preview            # preview | staging | production
PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=

# ---- service authentication (clients -> this service) ----------------------
AUTH_MODE=bearer                  # bearer | dev  (dev is refused in production)
# Entries separated by ';' fields by '|' lists by ','
# SERVICE_TOKENS="<token>|<user_id>|<project_id,...>|<scope,...>"
# scopes: catalogue:read, egordian:read, egordian:write, aeo:run, aeo:approve, admin
SERVICE_TOKENS=

# ---- persistence -----------------------------------------------------------
# Leave DATABASE_URL empty for the SQLite overlay (private preview).
DATABASE_URL=
OVERLAY_DB_PATH=/app/data.db
CATALOGUE_DB_PATH=/app/data/catalogue.sqlite

# ---- eGordian (this service -> jocservice.egordian.com) --------------------
EGORDIAN_BASE_URL=https://jocservice.egordian.com
EGORDIAN_AUTH_PROVIDER=none       # none | basic | bearer | headers
EGORDIAN_USERNAME=
EGORDIAN_PASSWORD=
EGORDIAN_BEARER_TOKEN=
# JSON object mapping header name -> environment variable name, e.g.
# EGORDIAN_HEADER_MAP={"Ocp-Apim-Subscription-Key":"EG_APIM_KEY"}
EGORDIAN_HEADER_MAP=
EGORDIAN_TIMEOUT_S=20
EGORDIAN_MAX_RETRIES=2
EGORDIAN_MAX_RESPONSE_BYTES=4194304

# ---- capability switches (all mutating paths default OFF) ------------------
ALLOW_EGORDIAN_WRITES=false
ALLOW_EGORDIAN_DELETE=false       # honoured only as an audit flag; DELETE stays blocked
ALLOW_ADMIN_OPERATIONS=false
EGORDIAN_WRITE_MODE=assisted      # assisted | gated_auto

# ---- limits ----------------------------------------------------------------
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120
CATALOGUE_MAX_RESULTS=50
HANDLE_TTL_HOURS=8

# ---- legacy clients --------------------------------------------------------
ALLOW_LEGACY_2025_CLIENTS=false
