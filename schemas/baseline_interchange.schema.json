{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntxp.local/gordian-ctc/baseline-interchange-v1.schema.json",
  "title": "eGordian Proposal Generator Baseline Interchange v1",
  "type": "object",
  "required": ["project_id", "known_budget", "scope_atoms"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "known_budget": {
      "type": "object",
      "required": ["record_id", "target_total", "currency", "source_ref"],
      "properties": {
        "record_id": {"type": "string"},
        "target_total": {"type": "number"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "source_ref": {"$ref": "#/$defs/source_ref"},
        "division_budgets": {"type": "object", "additionalProperties": {"type": "number"}}
      },
      "additionalProperties": false
    },
    "quotes": {"type": "array", "items": {"$ref": "#/$defs/quote"}},
    "qtos": {"type": "array", "items": {"$ref": "#/$defs/qto"}},
    "scope_atoms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scope_atom"}},
    "proposal_lines": {"type": "array", "items": {"$ref": "#/$defs/proposal_line"}},
    "user_comments": {"type": "array", "items": {"$ref": "#/$defs/comment"}},
    "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence_ref"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": ["source_type", "reference"],
      "properties": {"source_type": {"type": "string"}, "reference": {"type": "string"}, "page": {"type": "integer", "minimum": 1}},
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "required": ["evidence_id", "source_type", "reference"],
      "properties": {
        "evidence_id": {"type": "string"}, "source_type": {"enum": ["drawing", "specification", "quote", "qto", "photo", "catalogue", "user_note", "other"]},
        "reference": {"type": "string"}, "page": {"type": "integer", "minimum": 1}, "sheet": {"type": "string"},
        "coordinates": {"type": "string"}, "quoted_text": {"type": "string"}, "content_hash": {"type": "string"}
      },
      "additionalProperties": false
    },
    "quote": {
      "type": "object", "required": ["record_id", "vendor", "amount", "currency", "source_ref"],
      "properties": {"record_id": {"type": "string"}, "vendor": {"type": "string"}, "amount": {"type": "number"}, "currency": {"type": "string"}, "scope": {"type": "string"}, "source_ref": {"$ref": "#/$defs/source_ref"}, "user_notes": {"type": "string"}},
      "additionalProperties": false
    },
    "qto": {
      "type": "object", "required": ["record_id", "quantity", "unit", "quantity_math", "evidence_refs"],
      "properties": {"record_id": {"type": "string"}, "quantity": {"type": "number"}, "unit": {"type": "string"}, "quantity_math": {"type": "string"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}, "user_notes": {"type": "string"}},
      "additionalProperties": false
    },
    "scope_atom": {
      "type": "object", "required": ["record_id", "scope_text", "unit", "quantity", "evidence_refs"],
      "properties": {"record_id": {"type": "string"}, "scope_text": {"type": "string"}, "csi_code": {"type": "string"}, "unit": {"type": "string"}, "quantity": {"type": "number"}, "quantity_math": {"type": "string"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}, "user_notes": {"type": "string"}},
      "additionalProperties": false
    },
    "proposal_line": {
      "type": "object", "required": ["record_id", "division", "quantity", "unit", "quantity_math", "supported_value", "evidence_refs", "user_notes", "status"],
      "properties": {"record_id": {"type": "string"}, "division": {"type": "string", "pattern": "^\\d{2}$"}, "catalogue_code": {"type": "string"}, "quantity": {"type": "number"}, "unit": {"type": "string"}, "quantity_math": {"type": "string"}, "supported_value": {"type": "number"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}, "user_notes": {"type": "string"}, "status": {"enum": ["proposed", "approved", "rejected", "needs_review"]}},
      "additionalProperties": false
    },
    "comment": {"type": "object", "required": ["record_id", "author", "text"], "properties": {"record_id": {"type": "string"}, "author": {"type": "string"}, "text": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence_ref"}}}, "additionalProperties": false},
    "decision": {"type": "object", "required": ["record_id", "status", "actor", "approval"], "properties": {"record_id": {"type": "string"}, "status": {"enum": ["approve", "reject", "defer"]}, "actor": {"type": "string"}, "approval": {"const": true}, "rationale": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
