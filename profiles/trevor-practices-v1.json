{
  "profile_id": "trevor-practices",
  "version": "1.1.0",
  "status": "candidate_default_requires_contract_and_project_review",
  "scope": "reusable_policy",
  "precedence": 40,
  "provenance": {
    "type": "provided_practices",
    "recorded_at": "2026-08-07",
    "warning": "Every item below is a candidate estimating assumption. It is not universal construction truth, does not create scope or cost, and requires contract/project review plus named-human approval before use."
  },
  "invariants": {
    "baseline_spreadsheet_before_ui_entry": true,
    "always_capture_user_notes": true,
    "source_page_or_spec_reference_per_line": true,
    "quantity_justification_math_per_line": true,
    "bid_leveling_prioritization": "largest_division_deficit_first",
    "never_level_already_high_division": true,
    "final_reconciliation_requires_named_human": true,
    "scope_additions_require_named_human": true,
    "no_automatic_profile_promotion": true
  },
  "contract_configurable": {
    "division_01_availability": {
      "default": "unknown",
      "note": "The supplied October 2024 CTC contains Division 01. Do not import an RSMeans Division 01 exclusion; use only contract-specific availability."
    },
    "division_deficit_prioritization": {
      "default": "absolute_deficit_then_percentage",
      "allowed": ["absolute_deficit_then_percentage", "percentage_deficit_then_absolute"],
      "definition": "Only positive underrepresented divisions are eligible. Sort by the configured largest deficit measure first; zero/negative deficits are explicitly ineligible for bid-leveling."
    },
    "rounded_quantity_review": {
      "round_increment_candidates": [10, 25, 50, 100],
      "flag_integer_endings": ["00", "000"],
      "note": "Flagged quantities need source-backed calculation math; a named-human rationale may supplement review but never authorize an invented precise quantity."
    },
    "variance_bands": {"balanced_pct": 0.005, "warn_pct": 0.03},
    "stable_learning_threshold": {"min_cross_project_evidence": 3, "min_distinct_projects": 2}
  },
  "candidate_defaults": [
