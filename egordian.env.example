# Hostinger / registry deployment env file. Names and placeholders only.
#   cp egordian.env.example egordian.env && chmod 0600 egordian.env
#   docker compose -f docker-compose.hostinger.yml --env-file ./egordian.env up -d

# --- image ------------------------------------------------------------------
EGORDIAN_IMAGE=registry.example.com/joctools/egordian-aeo-mcp:1.0.0

# --- required ---------------------------------------------------------------
# entries ';' separated, fields '|' separated, lists ',' separated
SERVICE_TOKENS=<token>|<user>|<project>|catalogue:read,egordian:read,aeo:run,aeo:approve
CATALOGUE_DECRYPTION_KEY=<passphrase used by scripts/seal_catalogue.sh>
CATALOGUE_SHA256=<contents of build/catalogue.sha256>

# --- optional: pin the reassembled ciphertext for the public GitHub build ----
# sha256sum build/catalogue.enc | cut -d' ' -f1
CATALOGUE_ENC_SHA256=

# --- optional: durable control plane ----------------------------------------
DATABASE_URL=

# --- optional: eGordian upstream credentials --------------------------------
# Leave unset: the service starts, reports "disconnected", and eGordian tools
# return credential_required instead of failing.
EGORDIAN_BASE_URL=https://jocservice.egordian.com
EGORDIAN_AUTH_PROVIDER=none
EGORDIAN_USERNAME=
EGORDIAN_PASSWORD=
EGORDIAN_BEARER_TOKEN=
EGORDIAN_HEADER_MAP=

# --- optional: capability switches (all default to off) ---------------------
ALLOW_EGORDIAN_WRITES=false
ALLOW_ADMIN_OPERATIONS=false
ALLOW_LEGACY_2025_CLIENTS=false
RATE_LIMIT_PER_MINUTE=120
