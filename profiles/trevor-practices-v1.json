    {"id": "plumbing_system", "candidate_default_id": "plumbing_system", "when": ["plumbing", "fixture", "pipe", "sink"], "prompt": "Candidate default review: P-trap/rough-in, carriers, copper/supports, and 125 LF per fixture.", "blocking": false},
